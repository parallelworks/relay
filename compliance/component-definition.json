            "source": "https://raw.githubusercontent.com/usnistgov/oscal-content/78650f02ad9321bb7b817846f8fbd4f2bcd620de/nist.gov/SP800-53/rev5/json/NIST_SP-800-53_rev5_catalog.json",
            "description": "NIST SP 800-53 Rev 5 controls the relay implements or helps the system owner meet.",
            "implemented-requirements": [
              {
                "uuid": "c545b38f-82cf-4283-98d3-4385a58e19e5",
                "control-id": "ac-3",
                "description": "The relay opens a tunnel only for an access token that the authorization server reports active (RFC 7662), that is bound to the client's key (RFC 9449), that names this relay in its audience, and whose relay_target equals the requested address. The authorization server makes each access decision; the relay enforces it on every request and asks again for every tunnel, never caching an answer.",
                "props": [
                  {
                    "name": "mitigation",
                    "ns": "https://github.com/parallelworks/relay/ns/oscal",
                    "value": "M-16"
                  },
