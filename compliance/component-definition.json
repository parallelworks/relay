        "title": "relay",
        "description": "An HTTP CONNECT relay that gives clients TCP tunnels to hosts in a private network, each authorized by a DPoP-bound OAuth access token that the relay introspects with the authorization server.",
        "purpose": "Controlled remote access to private network hosts.",
        "responsible-roles": [
          {
            "role-id": "provider",
            "party-uuids": [
              "c2e79f58-e240-443a-a492-02e110a88251"
            ]
          }
        ],
        "control-implementations": [
          {
