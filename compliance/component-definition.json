              },
              {
                "uuid": "0890171b-0a1e-4748-b401-05fb1ebfaac1",
                "control-id": "ac-17",
                "description": "The relay is a managed access control point for remote access to hosts in a private network. Every connection uses TLS 1.3, every tunnel is authorized for one target by a sender-constrained token, and every tunnel is recorded and monitored through logs and metrics.",
