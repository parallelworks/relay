                "control-id": "ac-12",
                "description": "The relay re-introspects every open tunnel's session every 60 seconds by default and closes the tunnel when the session is inactive, belongs to another subject, or has expired. When the authorization server gives no valid answer for the grace period, 120 seconds by default, the tunnel closes. Tunnels also close after an idle timeout and a maximum lifetime.",
                "props": [
                  {
                    "name": "mitigation",
                    "ns": "https://github.com/parallelworks/relay/ns/oscal",
                    "value": "M-40"
                  },
